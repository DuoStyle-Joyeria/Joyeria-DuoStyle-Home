---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductoCard from '../components/ProductoCard.astro';
import { getCollection } from 'astro:content';
import { SITE, GENEROS, TIPOS, mensajeProducto, urlWhatsapp } from '../data/site-config';

const productos = await getCollection('productos', p => p.data.disponible);
const generosConProductos = GENEROS.filter(g =>
  productos.some(p => p.data.genero === g.slug)
);
const tiposConProductos = TIPOS.filter(t =>
  productos.some(p => p.data.tipo === t.slug)
);

let destacados = productos.filter(p => p.data.secciones.includes('destacado'));
if (destacados.length === 0) {
  destacados = productos.slice(0, 10);
} else {
  destacados = destacados.slice(0, 10);
}

const nuevos = productos.filter(p => p.data.secciones.includes('nuevo')).slice(0, 10);
---

<BaseLayout title="Inicio">
  <section id="inicio" class="hero-section">
    <video autoplay muted loop playsinline class="hero-video">
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-content">
      <h1>Elegancia que trasciende</h1>
      <p>{SITE.tagline}</p>
      <a class="btn-wsp-producto" href={urlWhatsapp(mensajeProducto('Colección DUO STYLE', 0))} target="_blank" rel="noopener">
        Comprar por WhatsApp
      </a>
    </div>
  </section>

  <section id="catalogo" class="catalogo-section">
    <h2>Catálogo</h2>
    <div class="categorias">
      {generosConProductos.map(g => (
        <a href={`/${g.slug}/`} class="categoria">{g.nombre}</a>
      ))}
    </div>
    <h3 class="subcategorias-titulo">Explora por tipo</h3>
    <div class="categorias categorias-tipo">
      {tiposConProductos.map(t => (
        <a href={`/${t.slug}/`} class="categoria categoria-tipo">{t.nombre}</a>
      ))}
    </div>
  </section>

  {destacados.length > 0 && (
    <section class="destacados-section">
      <h2>Destacados</h2>
      <div class="slider-track">
        {destacados.map(p => (
          <ProductoCard
            nombre={p.data.nombre}
            slug={p.data.slug}
            tipo={p.data.tipo}
            subtitulo={p.data.subtitulo}
            precio={p.data.precio}
            precioAnterior={p.data.precioAnterior}
            imagen={p.data.imagenes[0]}
          />
        ))}
      </div>
    </section>
  )}

  {nuevos.length > 0 && (
    <section class="destacados-section">
      <h2>Nuevos</h2>
      <div class="slider-track">
        {nuevos.map(p => (
          <ProductoCard
            nombre={p.data.nombre}
            slug={p.data.slug}
            tipo={p.data.tipo}
            subtitulo={p.data.subtitulo}
            precio={p.data.precio}
            precioAnterior={p.data.precioAnterior}
            imagen={p.data.imagenes[0]}
          />
        ))}
      </div>
    </section>
  )}

  <section id="contacto" class="contacto-section">
    <h2>¿Tienes dudas?</h2>
    <p>Escríbenos directamente, estamos para ayudarte.</p>
    <a class="btn-contacto" href={urlWhatsapp('Hola, tengo una consulta general para DUO STYLE.')} target="_blank" rel="noopener">
      Hablar por WhatsApp
    </a>
  </section>
</BaseLayout>
