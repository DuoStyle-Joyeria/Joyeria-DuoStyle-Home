---
import type { GetStaticPathsOptions } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductoCard from '../../components/ProductoCard.astro';
import { GENEROS, TIPOS } from '../../data/site-config';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const productos = await getCollection('productos', p => p.data.disponible);
  const generos = [...new Set(productos.map(p => p.data.genero))];

  return generos.flatMap(genero => {
    const items = productos
      .filter(p => p.data.genero === genero)
      .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre));
    const destacados = items.filter(p => p.data.secciones.includes('destacado')).slice(0, 10);
    const tiposDelGenero = [...new Set(items.map(p => p.data.tipo))];
    return paginate(items, { params: { genero }, props: { destacados, tiposDelGenero }, pageSize: 9 });
  });
}

const { genero } = Astro.params;
const { page, destacados, tiposDelGenero } = Astro.props as any;
const nombreGenero = GENEROS.find(g => g.slug === genero)?.nombre ?? genero;
const tiposConNombre = TIPOS.filter(t => tiposDelGenero.includes(t.slug));
---

<BaseLayout title={nombreGenero} description={`${nombreGenero} — Duo Style. Compra fácil y segura por WhatsApp.`}>
  <section class="catalogo-section">
    <h2>{nombreGenero}</h2>
    {tiposConNombre.length > 0 && (
      <div class="categorias categorias-tipo">
        {tiposConNombre.map((t: any) => (
          <a href={`/${genero}/${t.slug}/`} class="categoria categoria-tipo">{t.nombre}</a>
        ))}
      </div>
    )}
  </section>

  {page.currentPage === 1 && destacados.length > 0 && (
    <section class="destacados-section">
      <h2>Destacados en {nombreGenero}</h2>
      <div class="slider-track">
        {destacados.map((p: any) => (
          <ProductoCard
            nombre={p.data.nombre}
            slug={p.data.slug}
            tipo={p.data.tipo}
            subtitulo={p.data.subtitulo}
            precio={p.data.precio}
            precioAnterior={p.data.precioAnterior}
            imagen={p.data.imagenes[0]}
          />
        ))}
      </div>
    </section>
  )}

  <section class="catalogo-section">
    <h2>Todo en {nombreGenero}</h2>
    <div class="grid-productos">
      {page.data.map((p: any) => (
        <ProductoCard
          nombre={p.data.nombre}
          slug={p.data.slug}
          tipo={p.data.tipo}
          subtitulo={p.data.subtitulo}
          precio={p.data.precio}
          precioAnterior={p.data.precioAnterior}
          imagen={p.data.imagenes[0]}
        />
      ))}
    </div>

    {page.lastPage > 1 && (
      <nav class="paginador">
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(num => (
          <a
            href={num === 1 ? `/${genero}/` : `/${genero}/${num}/`}
            class={num === page.currentPage ? 'activo' : ''}
          >
            {num}
          </a>
        ))}
      </nav>
    )}
  </section>
</BaseLayout>
