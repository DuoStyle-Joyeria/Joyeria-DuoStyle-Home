---
import type { GetStaticPathsOptions } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductoCard from '../../components/ProductoCard.astro';
import { GENEROS } from '../../data/site-config';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const productos = await getCollection('productos', p => p.data.disponible);
  const generos = [...new Set(productos.map(p => p.data.genero))];

  return generos.flatMap(genero => {
    const items = productos
      .filter(p => p.data.genero === genero)
      .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre));
    return paginate(items, { params: { genero }, pageSize: 9 });
  });
}

const { genero } = Astro.params;
const { page } = Astro.props as any;
const nombreGenero = GENEROS.find(g => g.slug === genero)?.nombre ?? genero;
---

<BaseLayout title={nombreGenero} description={`${nombreGenero} — Duo Style. Compra fácil y segura por WhatsApp.`}>
  <section class="catalogo-section">
    <h2>{nombreGenero}</h2>
    <div class="grid-productos">
      {page.data.map((p: any) => (
        <ProductoCard
          nombre={p.data.nombre}
          slug={p.data.slug}
          tipo={p.data.tipo}
          subtitulo={p.data.subtitulo}
          precio={p.data.precio}
          precioAnterior={p.data.precioAnterior}
          imagen={p.data.imagenes[0]}
        />
      ))}
    </div>

    {page.lastPage > 1 && (
      <nav class="paginador">
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(num => (
          <a
            href={num === 1 ? `/${genero}/` : `/${genero}/${num}/`}
            class={num === page.currentPage ? 'activo' : ''}
          >
            {num}
          </a>
        ))}
      </nav>
    )}
  </section>
</BaseLayout>
