---
import { mensajeProducto, urlWhatsapp } from '../data/site-config';

interface Props {
  nombre: string;
  slug: string;
  tipo: string;
  subtitulo?: string;
  precio: number;
  precioAnterior?: number;
  imagen?: string;
}

const { nombre, slug, tipo, subtitulo, precio, precioAnterior, imagen } = Astro.props;
const precioFmt = precio.toLocaleString('es-CO');
const precioAnteriorFmt = precioAnterior?.toLocaleString('es-CO');
---

<a class="producto-card" href={`/${tipo}/${slug}/`}>
  {imagen && (
    <div class="imagen-wrap">
      <img src={imagen} alt={nombre} loading="lazy" />
      <button
        type="button"
        class="btn-add-carrito"
        aria-label={`Agregar ${nombre} al carrito`}
        data-nombre={nombre}
        data-tipo={tipo}
        data-slug={slug}
        data-precio={precio}
        data-imagen={imagen}
      >🛍️<span class="add-carrito-mas">+</span></button>
    </div>
  )}
  <h3>{nombre}</h3>
  {subtitulo && <p>{subtitulo}</p>}
  <div class="precio">
    <span class="precio-actual">${precioFmt}</span>
    {precioAnteriorFmt && <span class="precio-anterior">${precioAnteriorFmt}</span>}
  </div>
  <span
    class="btn-wsp-producto btn-wsp-card"
    data-mensaje={mensajeProducto(nombre, precio)}
  >
    Comprar por WhatsApp
  </span>
</a>

<script>
  import { urlWhatsapp } from '../data/site-config';
  import { agregarAlCarrito } from '../scripts/carrito';

  document.querySelectorAll<HTMLElement>('.btn-wsp-card').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const mensaje = btn.dataset.mensaje || '';
      window.open(urlWhatsapp(mensaje), '_blank');
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.btn-add-carrito').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      agregarAlCarrito({
        nombre: btn.dataset.nombre || '',
        tipo: btn.dataset.tipo || '',
        slug: btn.dataset.slug || '',
        precio: Number(btn.dataset.precio) || 0,
        imagen: btn.dataset.imagen,
      });
      btn.classList.add('agregado');
      setTimeout(() => btn.classList.remove('agregado'), 700);
    });
  });
</script>
