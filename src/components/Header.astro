---
import { getCollection } from 'astro:content';
import { SITE, GENEROS, TIPOS } from '../data/site-config';

const productos = await getCollection('productos');
const generosConProductos = GENEROS.map(g => ({
  ...g,
  tipos: TIPOS.filter(t => productos.some(p => p.data.genero === g.slug && p.data.tipo === t.slug)),
})).filter(g => g.tipos.length > 0);
---

<header class="main-header">
  <div class="header-inner">
    <a class="logo" href="/">
      <img src={SITE.logo} alt={SITE.nombre} />
    </a>
    <nav class="nav-container">
      <div class="hamburguesa" id="hamburguesa">☰</div>
      <ul class="nav-links" id="nav-links">
        <li><a href="/">Inicio</a></li>
        {generosConProductos.map(g => (
          <li class="nav-item-genero">
            <a href={`/${g.slug}/`}>{g.nombre}</a>
            <ul class="nav-submenu">
              {g.tipos.map(t => (
                <li><a href={`/${g.slug}/${t.slug}/`}>{t.nombre}</a></li>
              ))}
            </ul>
          </li>
        ))}
        <li><a href="/#contacto">Contacto</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const hamburguesa = document.getElementById('hamburguesa');
  const navLinks = document.getElementById('nav-links');
  hamburguesa?.addEventListener('click', () => {
    navLinks?.classList.toggle('show');
  });
  navLinks?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => navLinks.classList.remove('show'));
  });
</script>
